{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VELSEFY settings_schema.json",
  "description": "Declaración de settings globales de un tema VELSEFY (config/settings_schema.json). Igual que Shopify: un array de grupos { name, settings }. El grupo theme_info lleva la versión (theme_version, semver).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "settings"],
    "properties": {
      "name": { "type": "string", "description": "Nombre del grupo (ej. 'Colores', 'theme_info')" },
      "theme_name": { "type": "string" },
      "theme_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Versión semver del tema (Shopify-pura)" },
      "theme_author": { "type": "string" },
      "theme_documentation_url": { "type": "string", "format": "uri" },
      "theme_support_url": { "type": "string", "format": "uri" },
      "settings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type", "id", "label"],
          "properties": {
            "type": {
              "enum": ["color", "range", "number", "select", "text", "textarea", "checkbox", "image_picker", "richtext", "url"],
              "description": "Tipos de setting que soporta el renderer de VELSEFY (subconjunto, no la lista completa de Shopify)"
            },
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "info": { "type": "string" },
            "placeholder": { "type": "string" },
            "unit": { "type": "string" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" },
            "default": {},
            "options": {
              "type": "array",
              "items": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "type": "string" } } }
            }
          }
        }
      }
    }
  }
}
