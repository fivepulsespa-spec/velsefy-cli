{
    "name":  "@velsefy/theme-validate",
    "version":  "0.0.3",
    "description":  "Validador de temas VELSEFY (Liquid, JSON, rutas, semver, theme_info y plantilla de inicio).",
    "type":  "module",
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "files":  [
                  "dist",
                  "velsefy.settings_schema.json"
              ],
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc --noEmit",
                    "prepublishOnly":  "tsc -p tsconfig.json"
                },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "publishConfig":  {
                          "access":  "public"
                      },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "typescript":  "^5.6.0"
                        }
}